@page "/actividad10"
@rendermode InteractiveServer

<div class="mb-3" style="max-width: 300px;">
    <label for="codigoInput" class="form-label" style="font-weight: bold;">Ingrese el código de estado:</label>
    <input id="codigoInput" 
           type="number" 
           class="form-control" 
           @bind="CodigoEstado" 
           @bind:event="oninput" 
           placeholder="Ej. 200, 404, 500" />
</div>

<div class="d-inline-flex align-items-center p-2 rounded border" style="gap: 10px; background-color: #f8f9fa;">
    <!-- Indicador de color -->
    <span class="rounded-circle d-inline-block" 
          style="width: 16px; height: 16px; background-color: @ObtenerColorHex();">
    </span>

    <!-- Mensaje de estado -->
    <span style="font-weight: 500; color: #333;">
        @ObtenerMensajeEstado()
    </span>
</div>

@code {
    // Permite que esté vacío o inicie con un valor predeterminado (ej. 200)
    public int? CodigoEstado { get; set; } = 200;

    private string ObtenerMensajeEstado()
    {
        return CodigoEstado switch
        {
            200 => "Sistema Operacional",
            404 => "Recurso No Encontrado",
            500 => "Error Interno del Servidor",
            _   => "Estado Desconocido"
        };
    }

    private string ObtenerColorHex()
    {
        return CodigoEstado switch
        {
            200 => "#28a745", // Verde
            404 => "#ffc107", // Amarillo
            500 => "#dc3545", // Rojo
            _   => "#6c757d"  // Gris
        };
    }
}