@page "/examen"
@rendermode InteractiveServer

<div class="container mt-4">
    <h3 class="mb-4">Registro de productos</h3>

    @* Alertas de mensaje *@
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show my-2" role="alert">
            @mensajeError
            <button type="button" class="btn-close" @onclick='() => mensajeError = ""'></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show my-2" role="alert">
            @mensajeExito
            <button type="button" class="btn-close" @onclick='() => mensajeExito = ""'></button>
        </div>
    }

    @* Formulario de Captura *@
    <div class="mb-3">
        <label class="form-label d-block fw-bold">No. de inventario</label>
        <input type="number" class="form-control" style="max-width: 300px;" @bind="noInventarioInput" />
    </div>

    <div class="mb-3">
        <label class="form-label d-block fw-bold">Descripción</label>
        <input type="text" class="form-control" placeholder="Escribe la descripción del producto" @bind="descripcionInput" />
    </div>

    <div class="mb-3">
        <label class="form-label d-block fw-bold">Departamento</label>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="depGroup" id="rFrutas" 
                   checked='@(departamentoInput == "Frutas")' 
                   @onchange='() => departamentoInput = "Frutas"' />
            <label class="form-check-label" for="rFrutas">Frutas</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="depGroup" id="rVerduras" 
                   checked='@(departamentoInput == "Verduras")' 
                   @onchange='() => departamentoInput = "Verduras"' />
            <label class="form-check-label" for="rVerduras">Verduras</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="depGroup" id="rLacteos" 
                   checked='@(departamentoInput == "Lácteos")' 
                   @onchange='() => departamentoInput = "Lácteos"' />
            <label class="form-check-label" for="rLacteos">Lácteos</label>
        </div>
    </div>

    @* Botones *@
    <div class="d-flex flex-wrap gap-2 mb-4">
        <button type="button" class="btn btn-success" @onclick="GuardarDatos">Guardar datos</button>
        <button type="button" class="btn btn-success" @onclick='() => MostrarLista("Todos")'>Lista completa</button>
        <button type="button" class="btn btn-success" @onclick='() => MostrarLista("Frutas")'>Lista de frutas</button>
        <button type="button" class="btn btn-success" @onclick='() => MostrarLista("Verduras")'>Lista de verduras</button>
        <button type="button" class="btn btn-success" @onclick='() => MostrarLista("Lácteos")'>Lista de lácteos</button>
    </div>

    @* Tabla de Resultados *@
    @if (mostrarTabla)
    {
        <div class="mt-4">
            <table class="table table-striped table-hover border">
                <thead class="table-light">
                    <tr>
                        <th>No. Inventario</th>
                        <th>Descripción</th>
                        <th>Departamento</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int totalMostrados = 0;
                        for (int i = 0; i < listaNoInventario.Count; i++)
                        {
                            if (filtroDepartamento == "Todos" || listaDepartamento[i] == filtroDepartamento)
                            {
                                totalMostrados++;
                                <tr>
                                    <td>@listaNoInventario[i]</td>
                                    <td>@listaDescripcion[i]</td>
                                    <td>@listaDepartamento[i]</td>
                                </tr>
                            }
                        }
                        if (totalMostrados == 0)
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted">No hay registros guardados en esta lista.</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <button type="button" class="btn btn-success mt-2" @onclick="CerrarLista">Cerrar lista</button>
        </div>
    }
</div>

@code {
    // Tres listas en paralelo para guardar datos en memoria (sin clases)
    private List<int> listaNoInventario = new List<int>();
    private List<string> listaDescripcion = new List<string>();
    private List<string> listaDepartamento = new List<string>();

    // Variables de formulario
    private int noInventarioInput = 0;
    private string descripcionInput = "";
    private string departamentoInput = "Frutas";

    // Variables de control de UI
    private bool mostrarTabla = false;
    private string filtroDepartamento = "Todos";
    private string mensajeError = "";
    private string mensajeExito = "";

    private void GuardarDatos()
    {
        mensajeError = "";
        mensajeExito = "";

        // Validar descripción no vacía
        if (string.IsNullOrWhiteSpace(descripcionInput))
        {
            mensajeError = "Por favor escribe una descripción para el producto.";
            return;
        }

        // Restricción del examen: validar unicidad del número de inventario
        if (listaNoInventario.Contains(noInventarioInput))
        {
            mensajeError = $"El número de inventario {noInventarioInput} ya existe. Debe ser único.";
            return;
        }

        // Almacenar en las listas paralelas
        listaNoInventario.Add(noInventarioInput);
        listaDescripcion.Add(descripcionInput.Trim());
        listaDepartamento.Add(departamentoInput);

        // Limpiar los inputs y mostrar mensaje
        mensajeExito = "Producto guardado correctamente en memoria.";
        noInventarioInput = 0;
        descripcionInput = "";
        departamentoInput = "Frutas";
    }

    private void MostrarLista(string filtro)
    {
        filtroDepartamento = filtro;
        mostrarTabla = true;
    }

    private void CerrarLista()
    {
        mostrarTabla = false;
    }
}